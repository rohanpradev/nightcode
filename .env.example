# Vercel AI Gateway authentication (no provider API keys required).
# On Vercel deployments, VERCEL_OIDC_TOKEN is used automatically when present.
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key

# Night Code runtime defaults.
NIGHTCODE_PROVIDER=openai
NIGHTCODE_MODEL=gpt-6-astra
NIGHTCODE_PORT=3000
NIGHTCODE_SERVER_URL=http://localhost:3000

# LLM generation controls.
NIGHTCODE_MAX_TOKENS=16384
NIGHTCODE_TEMPERATURE=0.2
# GPT-6 reasoning requests omit temperature; this setting applies to supported models.
NIGHTCODE_AGENT_MODE=true
NIGHTCODE_REASONING_EFFORT=high
NIGHTCODE_APPROVAL_MODE=on-risk
NIGHTCODE_MAX_AGENT_STEPS=20

# Optional project behavior.
NIGHTCODE_SYSTEM_PROMPT=
NIGHTCODE_LOG_LEVEL=info
NIGHTCODE_DEBUG_STREAM=false
NIGHTCODE_TELEMETRY=false

# Canonical workspace roots accepted by the HTTP server. Separate multiple
# roots with ; on Windows or : on Unix. Defaults to the server working directory.
NIGHTCODE_SERVER_WORKSPACE_ROOTS=

# Optional local SQLite database path.
DATABASE_URL=file:./nightcode.db

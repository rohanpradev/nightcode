{
	"name": "nightcode",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"engines": {
		"bun": ">=1.3.14"
	},
	"packageManager": "bun@1.3.14",
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"typescript": "^7.0.2"
	},
	"scripts": {
		"dev": "bun run --parallel --if-present --filter '@nightcode/*' dev",
		"dev:cli": "bun --watch run packages/cli/src/index.tsx",
		"dev:server": "bun run --cwd packages/server dev",
		"build": "bun run --filter '@nightcode/*' build",
		"build:cli": "bun run --cwd packages/cli build",
		"build:cli:compile": "bun run --cwd packages/cli build:compile",
		"build:cli:bytecode": "bun run --cwd packages/cli build:bytecode",
		"link:cli": "bun link --cwd packages/cli",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov && bun run scripts/check-coverage.ts",
		"test:stress": "bun test --randomize --rerun-each=3",
		"test:server": "bun test packages/server/src",
		"eval:harness": "bun test packages/server/src/lib packages/server/src/services",
		"db:generate": "bun run --cwd packages/database db:generate",
		"db:push": "bun run --cwd packages/database db:push",
		"db:studio": "bun run --cwd packages/database db:studio",
		"db:migrate": "bun run --cwd packages/database db:migrate",
		"check": "bun run --parallel format:check lint typecheck",
		"check:fix": "bunx --no-install --bun @biomejs/biome check --write .",
		"format": "bunx --no-install --bun @biomejs/biome format --write .",
		"format:check": "bunx --no-install --bun @biomejs/biome format .",
		"lint": "bunx --no-install --bun @biomejs/biome lint .",
		"typecheck": "bun run --parallel --filter '@nightcode/*' typecheck",
		"verify": "bun run check && bun run test:coverage && bun run build",
		"deps:check": "bun outdated",
		"clean": "bun run scripts/clean.ts"
	},
	"workspaces": [
		"packages/*",
		"!packages/**/test/**",
		"!packages/**/template/**"
	]
}

# Required when NIGHTCODE_PROVIDER=openai.
OPENAI_API_KEY=sk-your-openai-api-key

# Night Code runtime defaults.
NIGHTCODE_PROVIDER=openai
NIGHTCODE_MODEL=gpt-5.5
NIGHTCODE_PORT=3000
NIGHTCODE_SERVER_URL=http://localhost:3000

# LLM generation controls.
NIGHTCODE_MAX_TOKENS=8192
NIGHTCODE_TEMPERATURE=0.2
NIGHTCODE_AGENT_MODE=true

# Optional OpenAI account or compatible endpoint settings.
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Optional Anthropic routing.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=

# Optional Azure OpenAI routing. Use your deployment name with NIGHTCODE_MODEL or /model.
AZURE_OPENAI_API_KEY=
AZURE_API_KEY=
AZURE_OPENAI_RESOURCE_NAME=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# Optional project behavior.
NIGHTCODE_SYSTEM_PROMPT=
NIGHTCODE_LOG_LEVEL=info
NIGHTCODE_DEBUG_STREAM=false

# Optional local SQLite database path.
DATABASE_URL=file:./nightcode.db

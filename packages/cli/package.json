{
	"name": "@nightcode/cli",
	"module": "src/index.tsx",
	"type": "module",
	"private": true,
	"bin": {
		"nightcode": "./bin/nightcode.ts"
	},
	"scripts": {
		"dev": "bun --watch run src/index.tsx",
		"build": "bun run scripts/build.ts bundle",
		"build:compile": "bun run scripts/build.ts compile",
		"build:bytecode": "bun run scripts/build.ts bytecode",
		"typecheck": "bun check --project tsconfig.json"
	},
	"devDependencies": {
		"@types/react": "^19.3.0"
	},
	"dependencies": {
		"@nightcode/database": "workspace:*",
		"@nightcode/server": "workspace:*",
		"@nightcode/shared": "workspace:*",
		"@opentui/core": "0.6.8",
		"@opentui/react": "0.6.8",
		"hono": "^4.13.14",
		"react": "^19.3.1",
		"zod": "^4.6.7"
	}
}

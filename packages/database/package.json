{
	"name": "@nightcode/database",
	"type": "module",
	"private": true,
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts",
		"./schema": "./src/schema.ts"
	},
	"scripts": {
		"build": "bun build src/index.ts --outdir dist --target bun --minify --sourcemap=external",
		"typecheck": "bunx --no-install --bun tsc --noEmit --checkers 8 -p tsconfig.json",
		"db:generate": "bunx --no-install --bun drizzle-kit generate",
		"db:push": "bunx --no-install --bun drizzle-kit push",
		"db:studio": "bunx --no-install --bun drizzle-kit studio",
		"db:migrate": "bunx --no-install --bun drizzle-kit migrate"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.2"
	},
	"devDependencies": {
		"drizzle-kit": "^0.31.10"
	}
}

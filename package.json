{
	"name": "nightcode",
	"version": "0.2.0",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"engines": {
		"bun": ">=1.4.4"
	},
	"packageManager": "bun@1.4.4",
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@types/bun": "1.4.4",
		"typescript": "7.0.2"
	},
	"scripts": {
		"dev": "bun run --parallel --if-present --filter '@nightcode/*' dev",
		"dev:cli": "bun --watch run packages/cli/src/index.tsx",
		"dev:server": "bun run --cwd packages/server dev",
		"build": "bun run --filter '@nightcode/*' build",
		"build:cli": "bun run --cwd packages/cli build",
		"build:cli:compile": "bun run --cwd packages/cli build:compile",
		"build:cli:bytecode": "bun run --cwd packages/cli build:bytecode",
		"link:cli": "bun link --cwd packages/cli",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov && bun run scripts/check-coverage.ts",
		"test:stress": "bun test --randomize --rerun-each=3",
		"test:server": "bun test packages/server/src",
		"test:server:live": "bun run scripts/test-server-live.ts",
		"test:gateway:live": "bun run scripts/test-gateway-live.ts",
		"test:cli:smoke": "bun run packages/cli/src/index.tsx --ui-smoke --ui-smoke-ms=300",
		"test:cli:bundle": "bun --no-env-file packages/cli/dist/index.js --ui-smoke --ui-smoke-ms=300",
		"eval:harness": "bun test packages/server/src/lib packages/server/src/services",
		"db:generate": "bun run --cwd packages/database db:generate",
		"db:up": "bun run --cwd packages/database db:up",
		"db:check": "bun run --cwd packages/database db:check",
		"db:push": "bun run --cwd packages/database db:push",
		"db:studio": "bun run --cwd packages/database db:studio",
		"db:migrate": "bun run --cwd packages/database db:migrate",
		"check": "bun run --parallel format:check lint typecheck typecheck:scripts",
		"check:fix": "bunx --no-install --bun @biomejs/biome lint --write . && bun run format",
		"format": "bun fmt --no-script",
		"format:check": "bun fmt --no-script --check",
		"format:changed": "bun fmt --no-script --changed=origin/main",
		"lint": "bunx --no-install --bun @biomejs/biome lint .",
		"typecheck": "bun run --parallel --filter '@nightcode/*' typecheck",
		"typecheck:scripts": "bun check --no-script --project scripts/tsconfig.json",
		"verify": "bun run check && bun run db:check && bun run test:coverage && bun run build",
		"deps:check": "bun outdated --recursive",
		"deps:audit": "bun audit",
		"clean": "bun run scripts/clean.ts"
	},
	"workspaces": [
		"packages/*"
	]
}

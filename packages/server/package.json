{
	"name": "@nightcode/server",
	"type": "module",
	"private": true,
	"exports": {
		".": "./src/index.ts",
		"./lib/agent-profiles": "./src/lib/agent-profiles.ts",
		"./lib/bounded-files": "./src/lib/bounded-files.ts",
		"./lib/context-engine": "./src/lib/context-engine.ts",
		"./lib/lsp-config": "./src/lib/lsp-config.ts",
		"./lib/skills": "./src/lib/skills.ts",
		"./services/llm": "./src/services/llm.ts"
	},
	"scripts": {
		"dev": "bun --watch run src/index.ts",
		"build": "bun build --check src/index.ts --outdir dist --target bun --minify --sourcemap=external",
		"test": "bun test src",
		"typecheck": "bun check --project tsconfig.json"
	},
	"dependencies": {
		"@ai-sdk/mcp": "2.0.84",
		"@hono/zod-validator": "^0.9.1",
		"@nightcode/database": "workspace:*",
		"@nightcode/shared": "workspace:*",
		"ai": "7.0.153",
		"dotenv": "^18.0.9",
		"hono": "^4.13.14",
		"zod": "^4.6.7"
	}
}

{
	"name": "@nightcode/database",
	"type": "module",
	"private": true,
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts",
		"./schema": "./src/schema.ts"
	},
	"scripts": {
		"build": "bun build --check src/index.ts --outdir dist --target bun --minify --sourcemap=external",
		"typecheck": "bun check --project tsconfig.json",
		"db:generate": "bunx --no-install --bun drizzle-kit generate",
		"db:up": "bunx --no-install --bun drizzle-kit up",
		"db:check": "bunx --no-install --bun drizzle-kit check",
		"db:push": "bunx --no-install --bun drizzle-kit push",
		"db:studio": "bunx --no-install --bun drizzle-kit studio",
		"db:migrate": "bunx --no-install --bun drizzle-kit migrate"
	},
	"dependencies": {
		"drizzle-orm": "1.0.0-rc.4"
	},
	"devDependencies": {
		"drizzle-kit": "1.0.0-rc.4"
	}
}

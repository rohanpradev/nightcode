{
	"name": "@nightcode/cli",
	"module": "src/index.tsx",
	"type": "module",
	"private": true,
	"bin": {
		"nightcode": "./bin/nightcode.ts"
	},
	"scripts": {
		"dev": "bun run --watch src/index.tsx",
		"build": "bun build src/index.tsx --outdir dist --target bun --minify --sourcemap=external",
		"build:bytecode": "bun build src/index.tsx --outdir dist --target bun --bytecode --minify --sourcemap=external",
		"build:compile": "bun build src/index.tsx --compile --bytecode --minify --sourcemap=external --outfile dist/nightcode"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/react": "^19.2.15"
	},
	"dependencies": {
		"@nightcode/server": "workspace:*",
		"@nightcode/shared": "workspace:*",
		"@opentui/core": "^0.2.15",
		"@opentui/react": "^0.2.15",
		"hono": "^4.12.22",
		"react": "^19.2.6",
		"zod": "^4.4.3"
	}
}
